# Deploye en tant que .htaccess dans /affinity sur O2Switch (voir deploy.sh).
#
# LiteSpeed gzippe deja text/html et application/javascript, donc index.html
# (78 Ko inline) et transcripts.js (285 Ko) partent compresses. On ajoute les
# types qu'il laisse passer en clair, au cas ou un fichier reviendrait.
# Pas de directive de cache : le navigateur revalide (304), donc un nouveau
# lot de fiches est visible tout de suite apres un deploiement.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/manifest+json image/svg+xml
</IfModule>
